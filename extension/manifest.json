{
  "manifest_version": 3,
  "name": "FetchVolt Browser Link",
  "version": "2.6.1",
  "description": "Send public HTTPS downloads to FetchVolt using an allowlisted local native host.",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'"
  }
}